# 复制为 secrets.env 后填入你自己的值（secrets.env 已被 .gitignore，不会入库）
# LLM 中转/官方 的 API Key（OpenAI 兼容）
LLM_API_KEY=sk-你的key

# 后台定时任务/告警绑定的业主租户 uid（单业主部署；注册首个账户后从 data/users.db 取其 uid 填入）
# 留空则后台任务读写全局 data/，登录用户在网页看不到其产出
TA_OWNER_UID=

# 注册控制（生产加固）：留空=开放注册；填任意口令=注册需该邀请码；填 off=完全关闭注册
# 建议：自己注册完账户后，改成 off 或一个只有你知道的邀请码
REGISTER_CODE=

# 监听地址/端口覆盖（可选）：上 nginx 反代时设 TA_HOST=127.0.0.1（只让本机 nginx 连，8760 不暴露公网）
# 留空 = 用 config.yaml 的 server.host(默认 0.0.0.0)
TA_HOST=
TA_PORT=
