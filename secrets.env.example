# 复制为 secrets.env 后填入你自己的值（secrets.env 已被 .gitignore，不会入库）
#
# 【自带 Key SaaS】LLM_API_KEY 通常留空 —— 每个用户注册后在网页里填自己的 Key(存各自账户)。
# 这里只是「全局兜底 Key」:仅当你想让没填 Key 的用户也能用你的 Key 时才填(会花你的钱,一般别填)。
LLM_API_KEY=

# 后台定时任务/告警绑定的业主租户 uid（单业主部署；注册首个账户后从 data/users.db 取其 uid 填入）
# 留空则后台任务读写全局 data/，登录用户在网页看不到其产出
TA_OWNER_UID=

# 注册控制（生产加固）：留空=开放注册；填任意口令=注册需该邀请码；填 off=完全关闭注册
# 建议：自己注册完账户后，改成 off 或一个只有你知道的邀请码
REGISTER_CODE=

# 监听地址/端口覆盖（可选）：上 nginx 反代时设 TA_HOST=127.0.0.1（只让本机 nginx 连，8760 不暴露公网）
# 留空 = 用 config.yaml 的 server.host(默认 0.0.0.0)
TA_HOST=
TA_PORT=

# 手机通知（可选，配任一即生效）
# 个人微信(最省事):Server酱 关注「方糖」公众号拿 SendKey / PushPlus 官网拿 token
SERVERCHAN_KEY=
PUSHPLUS_TOKEN=
# 群机器人:飞书群自定义机器人 / 企业微信群机器人
FEISHU_WEBHOOK=
WECHAT_WEBHOOK=

# 行情源 klineshare.cn 的 API Key(主源,东财/新浪/腾讯为备选);留空则只用备选
KLINESHARE_KEY=
